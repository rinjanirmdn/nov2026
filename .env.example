# Salin jadi .env lalu sesuaikan.

# Database PostgreSQL yang sama dengan yang dibuka di DBeaver.
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?schema=public
# (Di DBeaver: klik kanan koneksi -> Edit Connection untuk melihat host, port, user.)
DATABASE_URL="postgresql://postgres:GANTI_PASSWORD@localhost:5432/keuangan_berdua?schema=public"

# Kunci rahasia untuk cookie login, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Zona waktu untuk "hari ini" dan jatuh tempo. Ganti ke Asia/Makassar (WITA) atau Asia/Jayapura (WIT) kalau perlu.
APP_TIME_ZONE="Asia/Jakarta"
